# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Paddle Configuration
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=your_client_token_here
PADDLE_API_KEY=your_api_key_here
PADDLE_WEBHOOK_SECRET=your_webhook_secret_here

# Resend Email Configuration
RESEND_API_KEY=your_resend_api_key_here
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firecrawl Configuration (Job Scraping)
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Database
DATABASE_URL=your_database_connection_string_here

# Feature Flags
NEXT_PUBLIC_ENABLE_PADDLE=true
NEXT_PUBLIC_ENABLE_EMAIL_ALERTS=true

# Google Search Console / Indexing API (service account, path to the JSON key file)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./secrets/your-service-account-key.json
GOOGLE_SEARCH_CONSOLE_SITE=sc-domain:matchremote.io

# Bluesky distribution bot (bsky.app > Settings > App Passwords, never the main password)
BLUESKY_HANDLE=matchremote.bsky.social
BLUESKY_APP_PASSWORD=your_app_password_here
